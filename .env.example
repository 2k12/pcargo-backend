# Puerto HTTP de la API
PORT=3000
# postgres | memory  (memory = datos semilla en RAM, útil sin Docker)
DB_DRIVER=postgres
DATABASE_URL=postgres://pcargo:pcargo@localhost:5433/pcargo
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Redis (docker compose up -d redis) para caché y límite de tasa compartidos entre instancias.
# Sin REDIS_URL se usan en memoria del proceso. CACHE_DRIVER fuerza redis | memory | none.
REDIS_URL=redis://localhost:6380
# CACHE_DRIVER=redis
# Saltos de proxy inverso de confianza (nginx, balanceador) para el límite de tasa por IP real. 0 = ninguno.
# TRUST_PROXY=1
# Opcional: BD dedicada para tests de integración con Postgres
# TEST_DATABASE_URL=postgres://pcargo:pcargo@localhost:5433/pcargo_test
# Opcional: Redis para los tests de integración de caché (usan un espacio de claves aislado)
# TEST_REDIS_URL=redis://localhost:6380
# Almacén privado de archivos (fotos de evidencia de entrega): local | r2 | memory.
# Por defecto local (memory si DB_DRIVER=memory). Las fotos nunca se publican: la API las sirve con token.
STORAGE_DRIVER=local
# Carpeta del almacén local (relativa al directorio de trabajo). Por defecto <backend>/storage
# STORAGE_LOCAL_DIR=./storage
# Cloudflare R2 (S3 compatible), obligatorias con STORAGE_DRIVER=r2. Usa un bucket PRIVADO y un token
# de API con permiso de lectura/escritura solo sobre ese bucket. No subas valores reales al repo.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# ── API para empresas (integraciones) ──
# URL pública del frontend: arma seguimientoUrl (<PUBLIC_URL>/seguimiento/<guía>) en las respuestas de la API.
PUBLIC_URL=http://localhost:5173
# Clave de 32 bytes (base64 o hex) para cifrar con AES-256-GCM los secretos de los webhooks. Obligatoria para
# configurar webhooks (sin ella esas operaciones responden 503 SERVICIO_NO_CONFIGURADO). Genérela con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# No la cambie después de configurar webhooks: los secretos guardados dejarían de poder descifrarse.
INTEGRACIONES_CLAVE_CIFRADO=
# SOLO DESARROLLO: acepta webhooks http:// y desactiva el bloqueo anti-SSRF de destinos privados/loopback.
WEBHOOKS_PERMITIR_HTTP=false
# Despachador de webhooks en este proceso (false si otra instancia se encarga) y cada cuántos segundos revisa la cola.
WEBHOOKS_DESPACHADOR=true
WEBHOOKS_INTERVALO_SEG=15
# ── Datos personales (LOPDP) ──
# Depuración automática en este proceso (anonimiza envíos terminados fuera del plazo de conservación y elimina
# clientes inactivos) y cada cuántas horas se ejecuta (24 = una vez al día; 1–168).
DATOS_DEPURACION_AUTOMATICA=true
DATOS_DEPURACION_INTERVALO_HORAS=24
