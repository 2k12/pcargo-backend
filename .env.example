# Puerto HTTP de la API
PORT=3000
# postgres | memory  (memory = datos semilla en RAM, útil sin Docker)
DB_DRIVER=postgres
DATABASE_URL=postgres://pcargo:pcargo@localhost:5433/pcargo
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Redis (docker compose up -d redis) para caché y límite de tasa compartidos entre instancias.
# Sin REDIS_URL se usan en memoria del proceso. CACHE_DRIVER fuerza redis | memory | none.
REDIS_URL=redis://localhost:6380
# CACHE_DRIVER=redis
# Saltos de proxy inverso de confianza (nginx, balanceador) para el límite de tasa por IP real. 0 = ninguno.
# TRUST_PROXY=1
# Opcional: BD dedicada para tests de integración con Postgres
# TEST_DATABASE_URL=postgres://pcargo:pcargo@localhost:5433/pcargo_test
# Opcional: Redis para los tests de integración de caché (usan un espacio de claves aislado)
# TEST_REDIS_URL=redis://localhost:6380
